rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt == request.time
        && (data.get('xp', 0) is int && data.get('xp', 0) >= 0)
        && (data.get('level', 1) is int && data.get('level', 1) >= 1)
        && (data.get('streak', 0) is int && data.get('streak', 0) >= 0);
    }

    function isValidProgress(data, pathCourseId) {
      return data.keys().hasAll(['courseId', 'progress', 'updatedAt'])
        && data.courseId == pathCourseId
        && data.progress is int && data.progress >= 0 && data.progress <= 100
        && data.updatedAt == request.time;
    }

    // --- Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isEmailVerified() 
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt // Immutable
        && (
          // Action: Profile Update
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActive', 'streak', 'xp', 'level'])
        );
    }

    match /users/{userId}/progress/{courseId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidProgress(incoming(), courseId);
      allow update: if isOwner(userId) && isEmailVerified() 
        && isValidProgress(incoming(), courseId)
        && incoming().courseId == existing().courseId
        && incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'completedLessons', 'updatedAt']);
    }
  }
}
